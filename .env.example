# Obtain these values from Supabase Dashboard > Connect > App Frameworks / API Keys.
# These are intentionally public client configuration values. Do NOT place service_role
# keys, database passwords, Meta/WhatsApp tokens, or any server secret in this file.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Legacy projects may use this public key instead. Use one key variable only.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...replace_with_your_legacy_anon_key
